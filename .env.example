# ============================================
# Astroid - Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values.
# The only crypto-side env vars are read-only public addresses for the
# charity balance tracker - no private keys are ever stored here.

# ============================================
# Solana network for the on-chain charity balance tracker
# (READ-ONLY: no private keys are ever stored here.)
#
# IMPORTANT: the public RPC at api.mainnet-beta.solana.com aggressively
# rate-limits (HTTP 429) and is not viable for the cumulative-inflow
# scan that powers the donate.gg-routed wallet's lifetime total. Use a
# free tier from any of these for production:
#   - Helius        https://www.helius.dev/
#   - QuickNode     https://www.quicknode.com/
#   - Alchemy       https://www.alchemy.com/solana
#   - Triton        https://triton.one/
# Without a paid RPC the active-wallet inflow falls back to the live
# balance, which is correct as a floor but won't survive a sweep.
# ============================================
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ============================================
# Charity destination wallets (public Solana addresses)
#
# Fee split, post-routing-update:
#
#   25%  -> NEXT_PUBLIC_CHARITY_WALLET            (donate.gg -> St. Jude)
#   10%  -> NEXT_PUBLIC_CHARITY_WALLET_SECONDARY  (future children's charity)
#   65%  -> NEXT_PUBLIC_COMMUNITY_WALLET          (community + operations)
#  ----
#   100%
#
# All four variables are optional. /charity renders any subset cleanly
# with "pending recipient" cards for the slots that aren't filled in yet.
# ============================================

# The original ALSAC-provided St. Jude wallet, frozen post-switch. Set this
# to keep the historical balance visible on /charity as a permanent record
# of donations sent before the donate.gg routing went live. Optional - if
# unset, the legacy card simply isn't rendered.
NEXT_PUBLIC_CHARITY_WALLET_LEGACY=

# The active 25% charity wallet. With the donate.gg routing this is the
# verified-charity intake address that sweeps SOL onward, converts to USDC,
# and forwards to St. Jude Children's Research Hospital (EIN 62-0646012).
# Cumulative on-chain inflow is tracked server-side - the public ledger
# shows lifetime donations, not the live balance, so the number stays
# honest after each donate.gg sweep.
#
# Production value: 69gzuYrbVxZptyXnjcP2AxXVHKy4fW9wAbKF3U7nvit7
NEXT_PUBLIC_CHARITY_WALLET=

# Holding tank for the 10% routed to a future community-nominated children's
# charity. Funds accumulate here until a recipient confirms the routing in
# writing. Live balance is fine - this is an accumulator, not a pass-through.
#
# Production value: 3Zrt93Zvt5fLoRifjk3zC9n6boo53tKUdEs2DwC58E8C
NEXT_PUBLIC_CHARITY_WALLET_SECONDARY=

# Optional: the 65% community / operations wallet. If set, it appears on
# /charity for end-to-end transparency. If blank, the wallet is not shown
# (the page still notes the 65% allocation in copy).
NEXT_PUBLIC_COMMUNITY_WALLET=

# Legacy alias. Pre-update, the project wallet held the 75% portion;
# post-update the 75% portion becomes the 65% NEXT_PUBLIC_COMMUNITY_WALLET
# above (because of the 10% split-out). Kept here only for backwards
# compatibility with old .env.local files that still set this name; it is
# NOT read by the current code.
NEXT_PUBLIC_PROJECT_WALLET=

# ============================================
# Charity partner info (shown on /charity)
# ============================================
NEXT_PUBLIC_CHARITY_NAME=
NEXT_PUBLIC_CHARITY_URL=

# ============================================
# Optional: token mint + pump.fun page link
# ============================================
NEXT_PUBLIC_TOKEN_MINT=
NEXT_PUBLIC_PUMPFUN_URL=

# ============================================
# Public token-tracker listing pages. Used for the "Tracked on" badge strip
# on the home page and footer. The code already ships with the live coin
# URLs as defaults, so these env vars are only needed to rotate without a
# code change (e.g. if a tracker re-slugs the coin).
#
# Live defaults (current as of switch-over):
#   - https://www.coingecko.com/en/coins/thespaceshibainu
#   - https://blockspot.io/coin/thespaceshibainu/
# ============================================
NEXT_PUBLIC_COINGECKO_URL=
NEXT_PUBLIC_BLOCKSPOT_URL=

# ============================================
# Social handles. Defaults baked into the code already point at the live
# handles (https://x.com/Astroid_Sol, https://t.me/astroidcto). These env
# vars only need to be set if you want to override without redeploying a
# code change - e.g. handle rotation or temporary lock.
# ============================================
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# ============================================
# Public site URL. Used for absolute URLs in metadata (Open Graph,
# Twitter card images, certificates, sitemaps). Defaults to
# https://astroid.space if unset.
# ============================================
NEXT_PUBLIC_SITE_URL=https://astroid.space

# ============================================
# Moderation: long random string. Used by:
#   - The /admin sign-in page (sets a 12h HttpOnly session cookie).
#   - Header auth `x-admin-token` for curl / scripts:
#       POST /api/stars/moderate
#       POST /api/wishes/moderate
#       POST /api/coloring/moderate
#       POST /api/charity-nominations/moderate
#
# Must be at least 16 characters or admin endpoints stay disabled.
# Comparisons are timing-safe and rate-limited. Generate with:
#   openssl rand -hex 32
# ============================================
ADMIN_TOKEN=

# Used to sign the HttpOnly admin session cookie. MUST be different
# from ADMIN_TOKEN and at least 16 characters. Generate the same way.
ADMIN_COOKIE_SECRET=

# ============================================
# Set to "1" only when deployed behind a trusted reverse proxy that
# overwrites client-controlled IP headers (Vercel, Cloudflare, etc).
# Without this, IP-based rate limits collapse to a single shared
# bucket - safer than letting an attacker spoof per-IP buckets.
# Vercel auto-sets `VERCEL=1` which we also honour, so this is mostly
# for non-Vercel hosts.
# ============================================
TRUSTED_PROXY=

# ============================================
# Feature flags.
#   NEXT_PUBLIC_COLORING_UPLOADS_ENABLED
#     Default: off.  When set to "1" the /coloring page shows the upload
#     form and POST /api/coloring accepts submissions. Off until the
#     automated image-moderation pipeline (Cloudflare Workers AI / AWS
#     Rekognition / Sightengine / Hive) is wired up - see
#     IMAGE_MODERATION.md for integration code.
#
#     This is a NEXT_PUBLIC_ var so the client UI can hide the form
#     in lock-step with the API. Toggling requires a redeploy.
# ============================================
NEXT_PUBLIC_COLORING_UPLOADS_ENABLED=

# ============================================
# Storage backend.
#   memory  → process-local Maps. Fine for dev. Wiped on every restart
#             and on every cold start in serverless. NEVER use in prod.
#   supabase → persistent storage in Supabase Postgres + Storage.
#              Requires SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
#              Run `supabase/schema.sql` in the SQL editor first.
# Defaults to `memory` if unset.
# ============================================
STORAGE_BACKEND=memory

# ============================================
# Supabase credentials (only required when STORAGE_BACKEND=supabase).
# Find these in Supabase Dashboard → Project Settings → API Keys.
#   - SUPABASE_URL              → "Project URL"
#   - SUPABASE_SERVICE_ROLE_KEY → "Secret key" (sb_secret_...) - the new
#                                 name for what used to be called the
#                                 service_role key. Server-only. NEVER
#                                 expose to the browser or commit it.
#
# The "Publishable key" (sb_publishable_..., formerly anon) is NOT used
# by this codebase - server routes always go through the secret key.
# ============================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
